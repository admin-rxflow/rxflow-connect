    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.final_message }}",
        "options": {
          "systemMessage": "={{ $('Supabase: Config do Agente').first().json.system_prompt\n+ '\\n\\n# FARMÁCIA\\n- Nome: ' + $('Supabase: Config do Agente').first().json.pharmacy_name\n+ '\\n- Horário: ' + $('Supabase: Config do Agente').first().json.pharmacy_hours\n+ '\\n\\n# CONTEXTO DO ATENDIMENTO'\n+ '\\n- Tenant ID: ' + $json.tenant_id\n+ '\\n- Conversa ID: ' + $json.conversation_id\n+ '\\n- Telefone: ' + $json.customer_phone\n+ '\\n- Nome: ' + ($json.customer_name || 'Não informado')\n+ '\\n- ' + $json.customer_status\n+ '\\n- Tipo de mensagem: ' + $json.message_type\n+ ($json.is_prescription_candidate ? '\\n⚠️ ATENÇÃO: Cliente enviou receita médica! Verifique os dados extraídos e processe o pedido com receita.' : '')\n+ '\\n\\n# MODO AUTÔNOMO'\n+ '\\n- Ativo: ' + $('Supabase: Config do Agente').first().json.autonomous_mode\n+ '\\n- Limite auto-aprovação: R$ ' + $('Supabase: Config do Agente').first().json.autonomous_max_value\n+ '\\n\\n# HISTÓRICO DA CONVERSA (últimas mensagens)\\n' + $json.history_formatted\n+ '\\n\\n# MENSAGENS PADRÃO'\n+ '\\n- Espera: ' + $('Supabase: Config do Agente').first().json.msg_waiting\n+ '\\n- Receita: ' + $('Supabase: Config do Agente').first().json.msg_prescription_request\n+ '\\n- Controlado: ' + $('Supabase: Config do Agente').first().json.msg_controlled_warning\n+ '\\n- Encerramento: ' + $('Supabase: Config do Agente').first().json.msg_closing }}"
        }
      },
